# .env
INPUT_DIR=["D:/input_audio", "C:/test"]
OUTPUT_DIR=D:/output_audio
XML_FILENAME=Auto_MetaData.xml

# file retention period
FILE_RETENTION_DAYS=30

# processing
PROCESSING_SR=16000
PROCESSING_CH=1

# output
OUTPUT_SR=44100
OUTPUT_CH=2
OUTPUT_BR=192k

MAX_AUDIO_BYTES=52428800

# silence detection
SILENCE_DB=-30dB
SILENCE_DURATION=3.0
SILENCE_PADDING=0.3

# VAD settings
CLASS_PROB_THRESHOLD=0.15
MIN_SPEECH_S=20
MERGE_GAP_SECONDS=25
MARGIN_SECONDS_HEAD=2
MARGIN_SECONDS_TAIL=2
FADE_SECONDS=1

MUSIC_SENSITIVITY=1

# file format
OUTPUT_FORMAT=wav

# logs
LOG_DIR=D:\app\speechcut\logs
LOG_LEVEL=INFO

# bin for package
FFMPEG_EXE=./bin/ffmpeg.exe
FFPROBE_EXE=./bin/ffprobe.exe