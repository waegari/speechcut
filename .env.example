# .env
INPUT_DIR=["D:/input_audio", "C:/test"]
OUTPUT_DIR=D:/output_audio
XML_FILENAME=Auto_MetaData.xml

# file retention period
FILE_RETENTION_DAYS=30

# processing
PROCESSING_SR=16000
PROCESSING_CH=1

# output
OUTPUT_SR=44100
OUTPUT_CH=2
OUTPUT_BR=192k

MAX_AUDIO_BYTES=52428800

# silence detection
SILENCE_DB=-30dB
SILENCE_DURATION=3.0
SILENCE_PADDING=0.3

# VAD settings
CLASS_PROB_THRESHOLD=0.15
MIN_SPEECH_S=20
MERGE_GAP_SECONDS=25
MARGIN_SECONDS_HEAD=2
MARGIN_SECONDS_TAIL=2
FADE_SECONDS=1

MUSIC_SENSITIVITY=1

# file format
OUTPUT_FORMAT=wav

# logs
LOG_DIR=D:\app\eve\logs
LOG_LEVEL=INFO

# bin for package
FFMPEG_EXE=./bin/ffmpeg.exe
FFPROBE_EXE=./bin/ffprobe.exe

# API server
API_HOST=127.0.0.1
API_PORT=8001
JOB_DATA_DIR=./data/jobs
JOB_DB_PATH=./data/jobs.db
JOB_TIMEOUT_SECONDS=600
JOB_RETENTION_HOURS=6
MAX_UPLOAD_BYTES=52428800

# inference backend
INFERENCE_BACKEND=auto
INFERENCE_DEVICE=auto
ONNX_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
YAMNET_ONNX_PATH=./src/eve/ml/classifier/models/yamnet.onnx
ENABLE_TIMING_LOGS=true